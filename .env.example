# URL INTERNA del backend NestJS (solo en servidor Next.js, nunca NEXT_PUBLIC_).
BACKEND_URL=http://127.0.0.1:3000
# Origen público del frontend; usado para validar solicitudes de escritura.
APP_ORIGIN=http://localhost:3001
# Solo si el software principal está en OTRO dominio y enviará formulario POST de SSO.
# Nunca usar '*' ni habilitar dominios no controlados.
SSO_ALLOWED_ORIGINS=
NODE_ENV=development
